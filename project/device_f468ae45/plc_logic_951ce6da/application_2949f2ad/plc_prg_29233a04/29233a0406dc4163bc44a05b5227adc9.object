              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string)PROGRAM PLC_PRG\nVAR\n\tjoyst1 : SAEJ1939.Joystick;\nEND_VAR\nVAR_TEMP\n\tabButtPressStat : ARRAY[1..12] OF BYTE;\nEND_VAR\n",
                  "LineInfoPersistence": "(string)29233a04-06dc-4163-bc44-a05b5227adc9_Decl_LineIds"
